{#
  Expects: section, page, totalPages, totalItems, perPage, itemLabel (optional), query (optional hash of extra query params)
#}
{% if totalPages|default(1) > 1 %}
    {% set qs = query|default({}) %}
    <nav class="mt-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div class="small text-secondary">
            Стр. {{ page }} из {{ totalPages }}
            · показано {{ shown|default(0) }} из {{ totalItems }}
            {% if itemLabel|default('') %} {{ itemLabel }}{% endif %}
        </div>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item {{ page <= 1 ? 'disabled' : '' }}">
                <a class="page-link" href="{{ page <= 1 ? '#' : path('admin_section', {section: section}|merge(qs)|merge({page: page - 1})) }}">Назад</a>
            </li>
            {% set startPage = max(1, page - 2) %}
            {% set endPage = min(totalPages, page + 2) %}
            {% for p in startPage..endPage %}
                <li class="page-item {{ p == page ? 'active' : '' }}">
                    <a class="page-link" href="{{ path('admin_section', {section: section}|merge(qs)|merge({page: p})) }}">{{ p }}</a>
                </li>
            {% endfor %}
            <li class="page-item {{ page >= totalPages ? 'disabled' : '' }}">
                <a class="page-link" href="{{ page >= totalPages ? '#' : path('admin_section', {section: section}|merge(qs)|merge({page: page + 1})) }}">Вперёд</a>
            </li>
        </ul>
    </nav>
{% elseif totalItems|default(0) > 0 %}
    <div class="mt-2 small text-secondary">Показано {{ shown|default(totalItems) }} из {{ totalItems }}</div>
{% endif %}
