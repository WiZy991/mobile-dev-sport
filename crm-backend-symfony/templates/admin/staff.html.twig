{% extends 'admin/base.html.twig' %}

{% macro trainer_photo_src(photoUrl) %}
{%- if photoUrl -%}
{%- if photoUrl starts with 'http://' or photoUrl starts with 'https://' -%}
{{- photoUrl -}}
{%- elseif photoUrl starts with '/' -%}
{{- app.request.schemeAndHttpHost ~ photoUrl -}}
{%- else -%}
{{- app.request.schemeAndHttpHost ~ '/' ~ photoUrl -}}
{%- endif -%}
{%- endif -%}
{% endmacro %}

{% import _self as trainers %}

{% block body %}
<div class="content-header">
    <h1 class="h4 mb-0">Тренеры</h1>
    <p class="small text-secondary mb-0 mt-1">В клиентском приложении («Наша команда») видны только со статусом «Опубликован». Остальных можно скрыть без обновления APK.</p>
</div>

{% if admin_can_mutate() %}
<div class="content-card mb-3">
    <form method="post" action="{{ path('admin_trainer_new') }}" enctype="multipart/form-data" class="row g-2 align-items-end">
        <div class="col-auto">
            <label class="form-label small text-secondary d-block">Фото</label>
            <label class="trainer-photo-tile trainer-photo-tile--new" title="Выбрать фото">
                <input type="file" name="photo" accept=".jpg,.jpeg,.png,.webp,image/*" class="trainer-photo-input" data-photo-preview>
                <span class="trainer-photo-empty">+</span>
                <img class="trainer-photo-img d-none" alt="">
                <span class="trainer-photo-hint">Добавить</span>
            </label>
        </div>
        <div class="col-md-3">
            <label class="form-label small text-secondary">Имя</label>
            <input type="text" name="name" class="form-control form-control-sm" required>
        </div>
        <div class="col-md-3">
            <label class="form-label small text-secondary">Специализация</label>
            <input type="text" name="specialization" class="form-control form-control-sm">
        </div>
        <div class="col-md-2">
            <label class="form-label small text-secondary">Рейтинг</label>
            <input type="number" step="0.1" name="rating" class="form-control form-control-sm" min="0" max="5">
        </div>
        <div class="col-md-2">
            <label class="form-label small text-secondary">В приложении</label>
            <select name="publication_status" class="form-select form-select-sm">
                <option value="moderation" selected>На модерации</option>
                <option value="published">Опубликован</option>
                <option value="hidden">Скрыт</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small text-secondary">Телефон</label>
            <input type="tel" name="phone" class="form-control form-control-sm" placeholder="+7 (___) ___-__-__" inputmode="tel" maxlength="18" data-phone-mask>
        </div>
        <div class="col-md-3">
            <label class="form-label small text-secondary">Email (вход в приложение специалиста)</label>
            <input type="email" name="email" class="form-control form-control-sm" placeholder="trainer@example.com" autocomplete="off">
        </div>
        <div class="col-12">
            <label class="form-label small text-secondary">О себе (для приложения)</label>
            <textarea name="description" class="form-control form-control-sm" rows="3" placeholder="Кратко о опыте, подходе к тренировкам — текст увидят клиенты в карточке тренера."></textarea>
        </div>
        <div class="col-12 col-md-2 mt-2 mt-md-0">
            <button type="submit" class="btn btn-sm btn-primary w-100">Добавить тренера</button>
        </div>
    </form>
</div>
{% endif %}

<div class="content-card">
    <div class="table-responsive">
        <table class="table table-sm table-dark align-middle mb-0">
            <thead>
            <tr>
                <th style="width:3rem">ID</th>
                <th style="width:5.5rem">Фото</th>
                <th>Имя</th>
                <th>Email</th>
                <th>Специализация</th>
                <th>Рейтинг</th>
                <th>В приложении</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            {% for t in trainers %}
                {% set pub = t.publicationStatus %}
                {% set photoSrc = trainers.trainer_photo_src(t.photoUrl)|trim %}
                <tr>
                    <td>{{ t.id }}</td>
                    <td>
                        {% if admin_can_coach() %}
                            <div class="trainer-photo-tile {% if not photoSrc %}trainer-photo-tile--empty{% endif %}">
                                {% if photoSrc %}
                                    <img src="{{ photoSrc }}" alt="{{ t.name }}" class="trainer-photo-img" loading="lazy"
                                         onerror="this.classList.add('d-none'); this.parentElement.classList.add('trainer-photo-tile--empty');">
                                {% else %}
                                    <span class="trainer-photo-empty">Нет</span>
                                {% endif %}
                                <div class="trainer-photo-actions">
                                    <form method="post" action="{{ path('admin_trainer_photo', {id: t.id}) }}" enctype="multipart/form-data" class="trainer-photo-replace-form">
                                        <label class="trainer-photo-btn" title="{{ photoSrc ? 'Заменить фото' : 'Загрузить фото' }}">
                                            <input type="file" name="photo" accept=".jpg,.jpeg,.png,.webp,image/*" class="trainer-photo-input" data-auto-submit>
                                            <span>{{ photoSrc ? '↻' : '+' }}</span>
                                        </label>
                                    </form>
                                    {% if photoSrc %}
                                    <form method="post" action="{{ path('admin_trainer_photo_delete', {id: t.id}) }}" onsubmit="return confirm('Удалить фото тренера?')">
                                        <button type="submit" class="trainer-photo-btn trainer-photo-btn--danger" title="Удалить фото">×</button>
                                    </form>
                                    {% endif %}
                                </div>
                            </div>
                        {% else %}
                            {% if photoSrc %}
                                <img src="{{ photoSrc }}" alt="{{ t.name }}" class="trainer-photo-img trainer-photo-img--static" loading="lazy">
                            {% else %}
                                <span class="trainer-photo-placeholder">—</span>
                            {% endif %}
                        {% endif %}
                    </td>
                    <td>
                        {{ t.name }}
                        <a href="{{ path('admin_section', {section: 'schedule'}) }}?date={{ "now"|date("Y-m-d") }}" class="btn btn-sm btn-outline-secondary ms-1 py-0" title="Расписание">📅</a>
                    </td>
                    <td class="small">{{ t.email ?? '—' }}</td>
                    <td>{{ t.specialization ?? '—' }}</td>
                    <td>{{ t.rating is not null ? t.rating : '—' }}</td>
                    <td>
                        {% if pub == 'published' %}
                            <span class="badge text-bg-success">Опубликован</span>
                        {% elseif pub == 'moderation' %}
                            <span class="badge text-bg-warning text-dark">Модерация</span>
                        {% else %}
                            <span class="badge text-bg-secondary">Скрыт</span>
                        {% endif %}
                        {% if admin_can_coach() %}
                        <form method="post" action="{{ path('admin_trainer_publication', {id: t.id}) }}" class="d-inline ms-1">
                            {% if pub == 'published' %}
                                <input type="hidden" name="publication_status" value="hidden">
                                <button type="submit" class="btn btn-sm btn-outline-secondary py-0">Скрыть</button>
                            {% else %}
                                <input type="hidden" name="publication_status" value="published">
                                <button type="submit" class="btn btn-sm btn-outline-success py-0">Опубликовать</button>
                            {% endif %}
                        </form>
                        {% endif %}
                    </td>
                    <td>
                        {% if admin_can_coach() %}
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#edit-trainer-{{ t.id }}">Изменить</button>
                        {% endif %}
                        {% if admin_can_mutate() %}
                        <form method="post" action="{{ path('admin_trainer_delete', {id: t.id}) }}" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Удалить тренера?')">Удалить</button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
                {% if admin_can_coach() %}
                <tr class="collapse" id="edit-trainer-{{ t.id }}">
                        <td colspan="8" class="bg-dark py-2">
                            <form method="post" action="{{ path('admin_trainer_update', {id: t.id}) }}" class="row g-2 align-items-end">
                                <div class="col-md-2">
                                    <label class="form-label small mb-0">Имя</label>
                                    <input type="text" name="name" class="form-control form-control-sm" value="{{ t.name }}" required>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small mb-0">Специализация</label>
                                    <input type="text" name="specialization" class="form-control form-control-sm" value="{{ t.specialization ?? '' }}">
                                </div>
                                <div class="col-md-1">
                                    <label class="form-label small mb-0">Рейтинг</label>
                                    <input type="number" step="0.1" name="rating" class="form-control form-control-sm" value="{{ t.rating ?? '' }}" min="0" max="5">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small mb-0">В приложении</label>
                                    <select name="publication_status" class="form-select form-select-sm">
                                        <option value="published" {% if pub == 'published' %}selected{% endif %}>Опубликован</option>
                                        <option value="moderation" {% if pub == 'moderation' %}selected{% endif %}>На модерации</option>
                                        <option value="hidden" {% if pub == 'hidden' %}selected{% endif %}>Скрыт</option>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small mb-0">Телефон</label>
                                    <input type="tel" name="phone" class="form-control form-control-sm" value="{{ t.phone ?? '' }}" placeholder="+7 (___) ___-__-__" inputmode="tel" maxlength="18" data-phone-mask>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small mb-0">Email (staffapp)</label>
                                    <input type="email" name="email" class="form-control form-control-sm" value="{{ t.email ?? '' }}" placeholder="trainer@example.com" autocomplete="off">
                                </div>
                                <div class="col-12">
                                    <label class="form-label small mb-0">О себе (для приложения)</label>
                                    <textarea name="description" class="form-control form-control-sm" rows="3" placeholder="Текст для клиентов в приложении">{{ t.description ?? '' }}</textarea>
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-sm btn-success">Сохранить</button>
                                </div>
                            </form>
                            <p class="small text-secondary mb-0 mt-2">Фото меняйте в колонке «Фото»: наведите на снимок → заменить или удалить.</p>
                        </td>
                </tr>
                {% endif %}
            {% else %}
                <tr>
                    <td colspan="7" class="text-center text-secondary">
                        Персонал пока не добавлен.
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
<style>
.trainer-photo-tile {
    position: relative;
    width: 64px;
    height: 64px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.06);
    display: inline-flex;
    align-items: center;
    justify-content: center;
}
.trainer-photo-tile--new {
    width: 72px;
    height: 72px;
    cursor: pointer;
}
.trainer-photo-tile--empty {
    border-style: dashed;
}
.trainer-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}
.trainer-photo-img--static {
    width: 64px;
    height: 64px;
    border-radius: 12px;
    object-fit: cover;
    border: 1px solid rgba(255, 255, 255, 0.15);
}
.trainer-photo-empty {
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.75rem;
    font-weight: 600;
}
.trainer-photo-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2px 0;
    text-align: center;
    font-size: 0.65rem;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
}
.trainer-photo-input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
    width: 100%;
    height: 100%;
    z-index: 2;
}
.trainer-photo-actions {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    background: rgba(0, 0, 0, 0.55);
    opacity: 0;
    transition: opacity 0.15s ease;
    z-index: 3;
}
.trainer-photo-tile:hover .trainer-photo-actions,
.trainer-photo-tile:focus-within .trainer-photo-actions {
    opacity: 1;
}
.trainer-photo-btn {
    position: relative;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    border: 0;
    background: #fff;
    color: #111;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    margin: 0;
    overflow: hidden;
}
.trainer-photo-btn .trainer-photo-input {
    z-index: 4;
}
.trainer-photo-btn--danger {
    background: #dc3545;
    color: #fff;
    font-size: 1.1rem;
}
.trainer-photo-placeholder {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 12px;
    border: 1px dashed rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.45);
}
.trainer-photo-replace-form {
    margin: 0;
}
</style>
<script>
(() => {
    const formatPhone = (raw) => {
        const digits = String(raw || '').replace(/\D/g, '');
        let normalized = digits;
        if (normalized.startsWith('8')) {
            normalized = '7' + normalized.slice(1);
        }
        if (normalized && !normalized.startsWith('7')) {
            normalized = '7' + normalized;
        }
        if (!normalized) {
            return '';
        }
        const d = normalized.slice(0, 11);
        const p1 = d.slice(1, 4);
        const p2 = d.slice(4, 7);
        const p3 = d.slice(7, 9);
        const p4 = d.slice(9, 11);
        let out = '+7';
        if (p1) out += ' (' + p1;
        if (p1.length === 3) out += ')';
        if (p2) out += ' ' + p2;
        if (p3) out += '-' + p3;
        if (p4) out += '-' + p4;
        return out;
    };

    document.querySelectorAll('input[data-phone-mask]').forEach((input) => {
        const applyMask = () => {
            input.value = formatPhone(input.value);
        };
        input.addEventListener('input', applyMask);
        input.addEventListener('blur', applyMask);
        applyMask();
    });

    document.querySelectorAll('input[data-auto-submit]').forEach((input) => {
        input.addEventListener('change', () => {
            if (!input.files || !input.files.length) return;
            const form = input.closest('form');
            if (form) form.submit();
        });
    });

    document.querySelectorAll('input[data-photo-preview]').forEach((input) => {
        input.addEventListener('change', () => {
            const tile = input.closest('.trainer-photo-tile');
            if (!tile || !input.files || !input.files[0]) return;
            const img = tile.querySelector('.trainer-photo-img');
            const empty = tile.querySelector('.trainer-photo-empty');
            const url = URL.createObjectURL(input.files[0]);
            if (img) {
                img.src = url;
                img.classList.remove('d-none');
            }
            if (empty) empty.classList.add('d-none');
            tile.classList.remove('trainer-photo-tile--empty');
        });
    });
})();
</script>
{% endblock %}
