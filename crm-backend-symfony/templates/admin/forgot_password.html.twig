<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Восстановление пароля — CRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #14161a; color: #f5f5f5; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .card-login { background: #1c1f26; border: 1px solid #262b34; max-width: 400px; width: 100%; color: #f5f5f5; }
        .card-login h1 { color: #f5f5f5; }
        a { color: #ffcb45; }
    </style>
</head>
<body>
<div class="card card-login rounded-3 p-4 shadow">
    <h1 class="h5 mb-3">Восстановление пароля CRM</h1>
    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger py-2 small">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success py-2 small">{{ message }}</div>
    {% endfor %}
    <p class="small text-secondary">Укажите email сотрудника. Если он есть в системе, отправим письмо с кодом и ссылкой.</p>
    <form method="post">
        <label class="form-label small text-secondary">Email</label>
        <input type="email" class="form-control form-control-sm mb-2" name="email" value="{{ email }}" required autofocus autocomplete="username">
        {% if captcha %}
            <input type="hidden" name="captcha_id" value="{{ captcha.id }}">
            <label class="form-label small text-secondary">{{ captcha.question }}</label>
            <input type="text" class="form-control form-control-sm mb-2" name="captcha_answer" inputmode="numeric" autocomplete="off" required>
        {% endif %}
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_forgot') }}">
        <button type="submit" class="btn btn-warning w-100">Отправить письмо</button>
    </form>
    <p class="small mt-3 mb-0"><a href="{{ path('admin_login') }}">Назад ко входу</a></p>
</div>
</body>
</html>
