{% extends 'admin/base.html.twig' %}

{% block title %}CRM FitnessClub — Клиенты{% endblock %}

{% block body %}
    {% set export_base = path('admin_clients_export') ~ '?q=' ~ (search|default('')|url_encode) ~ '&tag_id=' ~ (filterTagId|default('')) ~ '&club_id=' ~ (filterClubId|default('')) ~ '&subscription=' ~ (filterSubscription|default('')|url_encode) %}
    <div class="content-header" data-dz-tour="clients-header">
        <h1 class="h4 mb-0">Клиенты <span class="text-secondary fs-6 fw-normal">({{ clients|length }})</span></h1>
        <div>
            <a href="{{ export_base ~ '&format=csv' }}" class="btn btn-sm btn-outline-success me-2">Скачать CSV</a>
            <a href="{{ export_base ~ '&format=xlsx' }}" class="btn btn-sm btn-success me-2">Скачать Excel</a>
            <a href="{{ path('admin_clients_import') }}" class="btn btn-sm btn-outline-primary me-2">Импорт CSV / Excel</a>
            <a href="{{ path('admin_client_new') }}" class="btn btn-sm btn-primary" data-dz-tour="clients-new">+ Новый клиент</a>
        </div>
    </div>

    <div class="content-card mb-3" data-dz-tour="clients-search">
        <form method="get" action="{{ path('admin_section', {section: 'clients'}) }}" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small mb-0">Поиск</label>
                <input type="text" name="q" class="form-control form-control-sm" placeholder="Имя, email, телефон..." value="{{ search|default('') }}">
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-0">Тег</label>
                <select name="tag_id" class="form-select form-select-sm">
                    <option value="">— Все —</option>
                    {% for tag in allTags|default([]) %}
                        <option value="{{ tag.id }}" {{ (filterTagId|default(null)) == tag.id ? 'selected' : '' }}>{{ tag.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-0">Клуб</label>
                <select name="club_id" class="form-select form-select-sm">
                    <option value="">— Все клубы —</option>
                    {% for club in allClubs|default([]) %}
                        <option value="{{ club.id }}" {{ (filterClubId|default(null)) == club.id ? 'selected' : '' }}>{{ club.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-0">Абонемент</label>
                <select name="subscription" class="form-select form-select-sm">
                    <option value="" {{ (filterSubscription|default('')) == '' ? 'selected' : '' }}>— Все —</option>
                    <option value="active" {{ filterSubscription|default('') == 'active' ? 'selected' : '' }}>Активный</option>
                    <option value="frozen" {{ filterSubscription|default('') == 'frozen' ? 'selected' : '' }}>Заморожен</option>
                    <option value="expired" {{ filterSubscription|default('') == 'expired' ? 'selected' : '' }}>Истёк / не действует</option>
                    <option value="any" {{ filterSubscription|default('') == 'any' ? 'selected' : '' }}>Любой абонемент (был/есть)</option>
                    <option value="none" {{ filterSubscription|default('') == 'none' ? 'selected' : '' }}>Без абонемента</option>
                    {% if subscriptionPlans|default([])|length > 0 %}
                        <optgroup label="По тарифу">
                            {% for plan in subscriptionPlans %}
                                <option value="plan:{{ plan.id }}" {{ filterSubscription|default('') == ('plan:' ~ plan.id) ? 'selected' : '' }}>
                                    {{ plan.name }}
                                    {%- if plan.type == 'limited' and plan.visitsCount %} · {{ plan.visitsCount }} пос.{% elseif plan.durationDays %} · {{ plan.durationDays }} дн.{% endif %}
                                </option>
                            {% endfor %}
                        </optgroup>
                    {% endif %}
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-primary">Найти</button>
            </div>
        </form>
    </div>

    {% if admin_can_mutate() %}
    <div class="content-card mb-3">
        <form method="post" action="{{ path('admin_clients_bulk_delete') }}" id="clients-bulk-form"
              onsubmit="return clientsBulkSubmit(event);">
            <input type="hidden" name="return_subscription" value="{{ filterSubscription|default('') }}">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="small text-secondary">Выбрано: <strong id="clients-selected-count" class="text-light">0</strong></span>
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-light dropdown-toggle" type="button" id="clients-bulk-actions"
                            data-bs-toggle="dropdown" aria-expanded="false" disabled>
                        Действия
                    </button>
                    <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="clients-bulk-actions">
                        <li>
                            <button type="submit" name="action" value="delete" class="dropdown-item text-danger">
                                Удалить выбранных
                            </button>
                        </li>
                    </ul>
                </div>
                <span class="text-secondary mx-1">|</span>
                <span class="small text-secondary">Без абонемента: <strong class="text-light">{{ clientsWithoutSubscriptionCount|default(0) }}</strong></span>
                <button type="submit"
                        formaction="{{ path('admin_clients_bulk_delete_without_subscription') }}"
                        name="action" value="delete_all_without_subscription"
                        class="btn btn-sm btn-outline-danger"
                        {{ (clientsWithoutSubscriptionCount|default(0)) == 0 ? 'disabled' : '' }}
                        onclick="return confirm('Удалить всех клиентов без абонемента ({{ clientsWithoutSubscriptionCount|default(0) }})?');">
                    Удалить всех без абонемента
                </button>
            </div>
        </form>
    </div>
    {% endif %}

    <div class="content-card" data-dz-tour="clients-table">
        <div class="table-responsive">
            <table class="table table-sm table-dark align-middle mb-0">
                <thead>
                <tr>
                    {% if admin_can_mutate() %}
                        <th style="width:2rem">
                            <input type="checkbox" class="form-check-input" id="clients-check-all" title="Выбрать всех без абонемента в списке">
                        </th>
                    {% endif %}
                    <th>ID</th>
                    <th>Имя</th>
                    <th>Абонемент</th>
                    <th>Клуб</th>
                    <th>Теги</th>
                    <th>Email</th>
                    <th>Телефон</th>
                    <th>Паспорт</th>
                    <th>Бонусы</th>
                    <th>Создан</th>
                </tr>
                </thead>
                <tbody>
                {% for client in clients %}
                    {% set sub = subscriptionSummaries[client.id]|default(null) %}
                    <tr>
                        {% if admin_can_mutate() %}
                            <td>
                                {% if sub is null %}
                                    <input type="checkbox" class="form-check-input client-row-check" form="clients-bulk-form" name="ids[]" value="{{ client.id }}">
                                {% else %}
                                    <span class="text-secondary" title="Есть абонемент — массовое удаление недоступно">—</span>
                                {% endif %}
                            </td>
                        {% endif %}
                        <td>
                            <a href="{{ path('admin_client_show', {id: client.id}) }}" class="link-light text-decoration-none">
                                {{ client.id }}
                            </a>
                        </td>
                        <td>
                            <a href="{{ path('admin_client_show', {id: client.id}) }}" class="link-light text-decoration-none">
                                {{ client.name }}
                            </a>
                        </td>
                        <td>
                            {% if sub %}
                                <div class="fw-semibold">{{ sub.label }}</div>
                                <div class="small text-secondary">{{ sub.plan_type }}{% if sub.visits %} · {{ sub.visits }}{% endif %}</div>
                                {% if sub.status == 'active' %}
                                    <span class="badge bg-success">Активен</span>
                                {% elseif sub.status == 'frozen' %}
                                    <span class="badge bg-warning text-dark">Заморожен</span>
                                {% elseif sub.status == 'pending' %}
                                    <span class="badge bg-info text-dark">Ожидает</span>
                                {% elseif sub.status == 'cancelled' %}
                                    <span class="badge bg-danger">Отменён</span>
                                {% else %}
                                    <span class="badge bg-secondary">Истёк</span>
                                {% endif %}
                                {% if sub.end %}
                                    <div class="small text-secondary">до {{ sub.end }}</div>
                                {% endif %}
                            {% else %}
                                <span class="text-secondary">Нет</span>
                            {% endif %}
                        </td>
                        <td>{{ client.club ? client.club.name : '—' }}</td>
                        <td>{% for tag in client.tags %}<span class="badge me-1" style="background-color: {{ tag.color ?? '#6c757d' }}">{{ tag.name }}</span>{% else %}—{% endfor %}</td>
                        <td>{{ client.email }}</td>
                        <td><a href="tel:{{ (client.phone ?? '')|replace({' ': '', '-': '', '(': '', ')': ''}) }}" class="link-light text-decoration-none">{{ client.phone }}</a></td>
                        <td>
                            {% if client.passportSeries and client.passportNumber %}
                                <span class="badge bg-success" title="Данные для абонемента заполнены">✓</span>
                            {% else %}
                                <span class="badge bg-warning text-dark" title="Заполните паспорт для выдачи абонемента">—</span>
                            {% endif %}
                        </td>
                        <td>{{ client.bonusPoints }}</td>
                        <td>{{ client.createdAt|date('d.m.Y H:i') }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="{{ admin_can_mutate() ? 11 : 10 }}" class="text-center text-secondary">
                            Клиенты не найдены.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <script>
        (function () {
            var all = document.getElementById('clients-check-all');
            var actionsBtn = document.getElementById('clients-bulk-actions');
            var countEl = document.getElementById('clients-selected-count');

            function selectedBoxes() {
                return Array.prototype.slice.call(document.querySelectorAll('.client-row-check:checked'));
            }

            function refreshSelection() {
                var n = selectedBoxes().length;
                if (countEl) countEl.textContent = String(n);
                if (actionsBtn) actionsBtn.disabled = n === 0;
            }

            if (all) {
                all.addEventListener('change', function () {
                    document.querySelectorAll('.client-row-check').forEach(function (cb) {
                        cb.checked = all.checked;
                    });
                    refreshSelection();
                });
            }
            document.querySelectorAll('.client-row-check').forEach(function (cb) {
                cb.addEventListener('change', refreshSelection);
            });
            refreshSelection();

            window.clientsBulkSubmit = function (event) {
                var submitter = event.submitter;
                var action = submitter && submitter.getAttribute('name') === 'action'
                    ? submitter.value
                    : 'delete';
                if (action === 'delete_all_without_subscription') {
                    return true;
                }
                if (selectedBoxes().length === 0) {
                    alert('Отметьте клиентов галочкой.');
                    return false;
                }
                return confirm('Удалить выбранных клиентов без абонемента (' + selectedBoxes().length + ')?');
            };
        })();
    </script>
{% endblock %}
