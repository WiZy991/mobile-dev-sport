{% extends 'admin/base.html.twig' %}

{% block title %}CRM FitnessClub — Группы клиентов{% endblock %}

{% block body %}
    <div class="content-header">
        <h1 class="h4 mb-0">Группы клиентов</h1>
    </div>

    <p class="text-secondary small mb-3">
        Создайте группу, задайте скидку в процентах и назначьте её клиенту в карточке.
        В приложении цены абонементов для таких клиентов сразу показываются со скидкой.
    </p>

    <div class="content-card mb-3">
        <form method="post" action="{{ path('admin_client_group_new') }}" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-secondary mb-0">Название группы *</label>
                <input type="text" name="name" class="form-control form-control-sm" placeholder="VIP, сотрудники…" required maxlength="100">
            </div>
            <div class="col-md-3">
                <label class="form-label small text-secondary mb-0">Скидка, %</label>
                <input type="number" name="discount_percent" class="form-control form-control-sm" value="0" min="0" max="100" step="0.01" required>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary">Создать группу</button>
            </div>
        </form>
    </div>

    <div class="content-card">
        <div class="table-responsive">
            <table class="table table-sm table-dark align-middle mb-0">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Название</th>
                    <th>Скидка</th>
                    <th>Клиентов</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% for group in groups %}
                    <tr>
                        <td>{{ group.id }}</td>
                        <td>
                            <form method="post" action="{{ path('admin_client_group_update', {id: group.id}) }}" class="row g-1 align-items-center">
                                <div class="col-auto">
                                    <input type="text" name="name" class="form-control form-control-sm" value="{{ group.name }}" required maxlength="100" style="min-width: 10rem;">
                                </div>
                                <div class="col-auto">
                                    <div class="input-group input-group-sm" style="width: 7rem;">
                                        <input type="number" name="discount_percent" class="form-control" value="{{ group.discountPercent }}" min="0" max="100" step="0.01" required>
                                        <span class="input-group-text">%</span>
                                    </div>
                                </div>
                                <div class="col-auto">
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Сохранить</button>
                                </div>
                            </form>
                        </td>
                        <td><span class="badge bg-success">{{ group.discountPercent }}%</span></td>
                        <td>{{ group.users|length }}</td>
                        <td>
                            <form method="post" action="{{ path('admin_client_group_delete', {id: group.id}) }}" class="d-inline" onsubmit="return confirm('Удалить группу? У клиентов поле «Группа» станет пустым.');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center text-secondary">Нет групп. Создайте группу и укажите скидку на абонементы.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
