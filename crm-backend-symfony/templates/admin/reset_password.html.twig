<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Новый пароль — CRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #14161a; color: #f5f5f5; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .card-login { background: #1c1f26; border: 1px solid #262b34; max-width: 400px; width: 100%; color: #f5f5f5; }
        a { color: #ffcb45; }
    </style>
</head>
<body>
<div class="card card-login rounded-3 p-4 shadow">
    <h1 class="h5 mb-3">Новый пароль</h1>
    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger py-2 small">{{ message }}</div>
    {% endfor %}
    {% if not valid %}
        <p class="small">Ссылка устарела или уже использована. Запросите восстановление ещё раз.</p>
        <p class="small mb-0"><a href="{{ path('admin_forgot_password') }}">Восстановить пароль</a></p>
    {% else %}
        <form method="post">
            <input type="hidden" name="token" value="{{ token }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_reset') }}">
            <label class="form-label small text-secondary">Новый пароль</label>
            <input type="password" class="form-control form-control-sm mb-2" name="password" required minlength="6" autocomplete="new-password">
            <label class="form-label small text-secondary">Повторите пароль</label>
            <input type="password" class="form-control form-control-sm mb-3" name="password_confirm" required minlength="6" autocomplete="new-password">
            <button type="submit" class="btn btn-warning w-100">Сохранить</button>
        </form>
    {% endif %}
    <p class="small mt-3 mb-0"><a href="{{ path('admin_login') }}">Ко входу</a></p>
</div>
</body>
</html>
