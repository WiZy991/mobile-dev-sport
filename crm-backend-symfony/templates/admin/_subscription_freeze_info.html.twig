{% set freezeTotal = subscription_freeze_days_total(sub) %}
{% if freezeTotal > 0 %}
    {{ sub.freezeDaysUsed ?? 0 }} / {{ freezeTotal }} дн.
    {% set left = subscription_freeze_days_left(sub) %}
    {% if left > 0 %}
        <span class="text-secondary">(ост. {{ left }})</span>
    {% endif %}
{% else %}
    <span class="text-secondary">нет</span>
{% endif %}
