{% extends 'legal/base.html.twig' %}

{% block title %}Восстановление пароля{% endblock %}

{% block body %}
    <h1>Восстановление пароля</h1>
    <article class="content">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <p style="padding:0.75rem 1rem;border-radius:12px;{% if type == 'danger' %}background:#fdecea;color:#8a1f11;{% else %}background:#e8f6ee;color:#165a32;{% endif %}">{{ message }}</p>
            {% endfor %}
        {% endfor %}

        {% if link_token and link_valid %}
            <p>Придумайте новый пароль для входа в приложение <strong>{{ club_name }}</strong>.</p>
            <form method="post" style="display:grid;gap:0.75rem;max-width:420px;">
                <input type="hidden" name="action" value="reset">
                <input type="hidden" name="token" value="{{ link_token }}">
                <label>Новый пароль
                    <input type="password" name="password" required minlength="6" style="width:100%;padding:0.7rem 0.85rem;border:1px solid var(--border);border-radius:12px;">
                </label>
                <label>Повторите пароль
                    <input type="password" name="password_confirm" required minlength="6" style="width:100%;padding:0.7rem 0.85rem;border:1px solid var(--border);border-radius:12px;">
                </label>
                <button type="submit" style="background:var(--primary);color:#fff;border:0;border-radius:999px;padding:0.75rem 1.2rem;font-weight:700;cursor:pointer;">Сохранить пароль</button>
            </form>
        {% elseif link_token and not link_valid %}
            <p>Ссылка устарела или уже использована. Запросите восстановление ещё раз.</p>
        {% else %}
            <p>Укажите email, с которым вы входите в приложение. Мы отправим письмо с кодом и ссылкой.</p>
            <form method="post" style="display:grid;gap:0.75rem;max-width:420px;">
                <input type="hidden" name="action" value="request">
                <label>Email
                    <input type="email" name="email" required autocomplete="email" style="width:100%;padding:0.7rem 0.85rem;border:1px solid var(--border);border-radius:12px;">
                </label>
                {% if captcha %}
                    <input type="hidden" name="captcha_id" value="{{ captcha.id }}">
                    <label>{{ captcha.question }}
                        <input type="text" name="captcha_answer" inputmode="numeric" autocomplete="off" required style="width:100%;padding:0.7rem 0.85rem;border:1px solid var(--border);border-radius:12px;">
                    </label>
                {% endif %}
                <button type="submit" style="background:var(--primary);color:#fff;border:0;border-radius:999px;padding:0.75rem 1.2rem;font-weight:700;cursor:pointer;">Отправить письмо</button>
            </form>
        {% endif %}

        <p style="margin-top:1.5rem;">Если письма нет — проверьте папку «Спам». Можно также позвонить в клуб:
            <a href="tel:{{ phone|replace({' ': '', '(': '', ')': '', '-': ''}) }}">{{ phone }}</a>
        </p>
        <p><a href="/">На главную</a></p>
    </article>
{% endblock %}
